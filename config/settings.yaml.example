telegram_bot_token: "YOUR_BOT_TOKEN_HERE"
allowed_users: []   # list of telegram user IDs (integers); empty = no restriction
work_dir: "/tmp/openlucky_work"
claude_bin: "/home/you/.local/bin/claude"  # use absolute path for systemd
session_timeout_minutes: 30
log_level: "INFO"
data_dir: "data"

# Optional second-brain directory. If set, Claude can read and write files here.
# Leave empty to disable.
second_brain_dir: ""

