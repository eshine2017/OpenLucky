telegram_bot_token: "YOUR_BOT_TOKEN_HERE"
allowed_users: []   # list of telegram user IDs (integers); empty = no restriction
work_dir: "/tmp/openlucky_work"
claude_bin: "/home/you/.local/bin/claude"  # use absolute path for systemd
session_timeout_minutes: 30
log_level: "INFO"
data_dir: "data"

# Optional second-brain directory. If set, Claude can read and write files here.
# Leave empty to disable.
second_brain_dir: ""

# AI provider selection. Options: "claude" (default), "gemini".
provider: "claude"

# Default Claude model. Options: alias ("opus", "sonnet", "haiku", "fable") or a
# full model ID (e.g. "claude-opus-5"); empty = CLI default. Overridden per-chat
# by !model, and per-job by cron.json's "model" field.
claude_model: ""

# Gemini CLI configuration (only used when provider is "gemini" or !provider switches to it).
gemini_bin: "gemini"   # use absolute path for systemd
gemini_model: ""       # e.g. "gemini-2.0-flash"; empty = CLI default

